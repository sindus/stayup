# Copy this file to .env and fill in your values.

# The stayup-api instance this connector reports to.
STAYUP_API_URL=http://localhost:3000

# API key for the 'changelog' provider, created from that instance's admin
# (Settings → Connector keys). Scoped to 'changelog' only.
STAYUP_API_KEY=

# Optional — increases the GitHub API rate limit from 60 to 5000 requests/hour
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
